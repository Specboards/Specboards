{
  "name": "specboards",
  "version": "1.1.2",
  "private": true,
  "description": "Lightweight, spec-based product management layer over git-native specs. Open-core self-host (AGPL-3.0) + hosted SaaS.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-unused-by-the-db-service} docker compose -f infra/docker-compose.yml up -d db",
    "db:migrate": "pnpm --filter @specboards/db migrate",
    "db:seed": "pnpm --filter @specboards/db seed",
    "deploy:test": "scripts/deploy.sh test",
    "deploy:prod": "scripts/deploy.sh production",
    "release:prepare": "scripts/release-prepare.sh",
    "release:check": "scripts/release-guard.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "audit": "scripts/audit.sh",
    "audit:keys": "pnpm --filter @specboards/db audit:keys",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "knip": "^5.88.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.4",
      "fast-uri": ">=4.1.3",
      "ip-address": ">=10.3.1",
      "shell-quote": ">=1.9.0",
      "hono": ">=4.13.5",
      "@hono/node-server": "^1.19.15",
      "body-parser": ">=2.3.0",
      "nanoid": ">=3.3.17",
      "qs": ">=6.16.0"
    },
    "patchedDependencies": {
      "sonner@2.0.7": "patches/sonner@2.0.7.patch"
    },
    "auditConfig": {
      "ignoreGhsas": ["GHSA-82fw-gwwq-j7x9"]
    }
  }
}
