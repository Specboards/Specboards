{
  "name": "specboards",
  "version": "0.26.0",
  "private": true,
  "description": "Lightweight, spec-based product management layer over git-native specs. Open-core self-host (AGPL-3.0) + hosted SaaS.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d db",
    "db:migrate": "pnpm --filter @specboards/db migrate",
    "db:seed": "pnpm --filter @specboards/db seed",
    "deploy:test": "scripts/deploy.sh test",
    "deploy:prod": "scripts/deploy.sh production",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "audit": "pnpm audit --prod --audit-level high --ignore-registry-errors"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "fast-uri": ">=4.1.2",
      "ip-address": ">=10.3.1",
      "shell-quote": ">=1.9.0",
      "hono": ">=4.12.27",
      "body-parser": ">=2.3.0",
      "nanoid": ">=3.3.17"
    },
    "patchedDependencies": {
      "sonner@2.0.7": "patches/sonner@2.0.7.patch"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-frvp-7c67-39w9"
      ]
    }
  }
}
